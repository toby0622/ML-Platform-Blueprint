POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=mlplatform
MINIO_ROOT_PASSWORD=change-me-too
MLFLOW_S3_BUCKET=mlflow-artifacts
ML_PLATFORM_TENANTS=team-a,team-b
ML_PLATFORM_CODE_REVISION=local-compose
PORTAL_PORT=3001
# Portal server-side URL for the independently started local GPU Compose stack.
PORTAL_VLLM_API_URL=http://host.docker.internal:8000

# Optional local NVIDIA GPU / vLLM profile.
# The default model is public, Apache-2.0 licensed, and comfortably fits a 16 GB GPU.
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Change or clear this revision whenever VLLM_MODEL points at another repository.
VLLM_MODEL_REVISION=989aa7980e4cf806f80c7fef2b1adb7bc71aa306
VLLM_SERVED_MODEL_NAME=qwen2.5-1.5b-instruct
VLLM_PORT=8000
VLLM_DTYPE=auto
VLLM_QUANTIZATION=
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_MAX_NUM_SEQS=32
VLLM_MAX_NUM_BATCHED_TOKENS=
VLLM_ENABLE_PREFIX_CACHING=false
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_KV_CACHE_DTYPE=auto
# Only required for gated/private Hugging Face models. Do not commit a real token.
HF_HUB_DISABLE_XET=1
# If Xet is enabled, keep its range-request concurrency bounded on WSL.
HF_XET_FIXED_DOWNLOAD_CONCURRENCY=8
HF_TOKEN=
